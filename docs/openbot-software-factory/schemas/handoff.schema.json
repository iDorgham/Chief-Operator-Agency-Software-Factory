{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "handoff.schema.json",
  "title": "OpenBot to T3 handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "client_id",
    "project_id",
    "feature_id",
    "spec_path",
    "spec_version",
    "repo_path",
    "worktree_or_branch",
    "ticket_ids",
    "acceptance_criteria",
    "do_not_touch",
    "test_commands",
    "result_path",
    "status",
    "prepared_by"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_path": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "repo_path": {
      "type": "string",
      "minLength": 1
    },
    "worktree_or_branch": {
      "type": "string",
      "minLength": 1
    },
    "ticket_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "do_not_touch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "test_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_path": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "approved-for-implementation"
    },
    "prepared_by": {
      "type": "string",
      "minLength": 1
    }
  }
}
