{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result.schema.json",
  "title": "T3/Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "client_id",
    "project_id",
    "feature_id",
    "spec_version",
    "branch_or_worktree",
    "pr_reference",
    "summary",
    "changed_files",
    "tests",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "client_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_version": {
      "type": "string",
      "minLength": 1
    },
    "branch_or_worktree": {
      "type": "string",
      "minLength": 1
    },
    "pr_reference": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "status",
          "details"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "not-run",
              "blocked"
            ]
          },
          "details": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
