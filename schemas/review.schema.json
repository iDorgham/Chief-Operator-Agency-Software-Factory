{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/review.schema.json",
  "title": "Independent Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_id", "task_id", "project_id", "reviewer", "independent_from_owner", "criteria", "findings", "decision", "reviewed_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "review_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "independent_from_owner": {"const": true},
    "criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["criterion", "status"], "properties": {"criterion": {"type": "string"}, "status": {"enum": ["pass", "fail", "not-evidenced"]}, "evidence_refs": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "findings": {"type": "array", "items": {"type": "object", "required": ["severity", "summary"], "properties": {"severity": {"enum": ["critical", "high", "medium", "low", "note"]}, "summary": {"type": "string"}, "evidence_ref": {"type": ["string", "null"]}}, "additionalProperties": false}},
    "decision": {"enum": ["approve", "request-changes", "blocked"]},
    "reviewed_at": {"type": "string", "format": "date-time"}
  }
}
