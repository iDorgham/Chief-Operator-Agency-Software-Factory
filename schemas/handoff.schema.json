{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/handoff.schema.json",
  "title": "Delegation Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "handoff_id", "task_id", "project_id", "from", "to", "objective", "deliverable", "acceptance_criteria", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "handoff_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "client_id": {"type": ["string", "null"]},
    "from": {"type": "string", "minLength": 1},
    "to": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "approved_input_refs": {"type": "array", "items": {"type": "string"}},
    "deliverable": {"type": "string", "minLength": 1},
    "allowed_scope": {"type": "array", "items": {"type": "string"}},
    "exclusions": {"type": "array", "items": {"type": "string"}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "permissions": {"type": "array", "items": {"type": "string"}},
    "stop_conditions": {"type": "array", "items": {"type": "string"}},
    "return_path": {"type": "string"},
    "status": {"enum": ["draft", "approved", "accepted", "returned", "rejected", "cancelled"]},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
