{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://factory.local/schemas/improvement.schema.json",
  "title": "Improvement Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal_id", "owner", "evidence_refs", "problem", "change", "expected_benefit", "risk", "validation", "rollback", "status"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "problem": {"type": "string", "minLength": 1},
    "change": {"type": "string", "minLength": 1},
    "expected_benefit": {"type": "string", "minLength": 1},
    "risk": {"type": "string", "minLength": 1},
    "validation": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "status": {"enum": ["proposed", "approved", "rejected", "testing", "adopted", "rolled-back"]}
  }
}
